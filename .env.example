# Local access gate. Keep real values in .env, never commit them.
NUXT_GAME_AUTH_USERNAME=admin
NUXT_GAME_AUTH_PASSWORD=replace-with-a-local-password

# Vercel CLI credentials. Do not expose these through NUXT_PUBLIC_* variables.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# GitHub CLI — Projects & Issues API (gh, scripts). Keep the real token in .env only.
# Fine-grained: https://github.com/settings/personal-access-tokens/new
#   Permissions: Issues + Projects (Read and write) on arvaistary/sim_game.
# Classic (recommended for gh project): https://github.com/settings/tokens/new
#   Scopes: repo, project.
GH_TOKEN=
GH_TOKEN_CLASSIC=
