{
  "name": "game_life",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "packages/domain",
    "packages/application"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:architecture": "vitest run test/unit/architecture/package-boundaries.test.ts test/unit/architecture/extracted-packages.test.ts",
    "test:standalone-server": "vitest run test/integration/standalone-server/app.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "node scripts/dev-stack.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "node scripts/db-migrate.mjs migrate",
    "db:status": "node scripts/db-migrate.mjs status",
    "dev:client": "cross-env NUXT_PUBLIC_GAME_MODE=server NUXT_PUBLIC_GAME_API_BASE_URL=http://127.0.0.1:3001 nuxt dev --port 3000",
    "dev:server": "cross-env NUXT_PUBLIC_GAME_MODE=server NUXT_GAME_CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000 nuxt dev --port 3001",
    "dev:standalone-server": "tsx --tsconfig tsconfig.server.json apps/server/src/index.ts",
    "build": "nuxt build",
    "build:client": "nuxt generate",
    "build:server": "nuxt build",
    "start:server": "node .output/server/index.mjs",
    "start:standalone-server": "tsx --tsconfig tsconfig.server.json apps/server/src/index.ts",
    "audit:action-age-groups": "node scripts/audit-action-age-groups.mjs",
    "rules:audit": "node scripts/rules-audit.mjs",
    "rules:audit:changed": "node scripts/rules-audit-changed.mjs",
    "rules:fix": "node scripts/fix-code.mjs",
    "audit:integrity": "node --experimental-strip-types scripts/integrity-audit/index.ts",
    "audit:integrity:validate": "node --experimental-strip-types scripts/integrity-audit/validate.ts",
    "test:e2e:integrity": "node --experimental-strip-types scripts/e2e/run-integrity.ts",
    "test:e2e:integrity:regression": "vitest run --config vitest.integrity.config.ts",
    "lint": "eslint --ext .ts,.vue .",
    "lint:fix": "eslint --ext .ts,.vue . --fix",
    "lint:style": "stylelint \"src/**/*.{css,scss}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "typecheck": "nuxt typecheck",
    "typecheck:packages": "tsc --noEmit --ignoreConfig --strict --target ES2022 --module ESNext --moduleResolution bundler packages/contracts/src/index.ts packages/domain/src/index.ts packages/application/src/index.ts",
    "typecheck:standalone-server": "tsc --noEmit --project tsconfig.server.json",
    "typecheck:watch": "nuxt typecheck --watch",
    "prepare": "husky",
    "mem": "node scripts/mempalace.mjs",
    "mem:init": "node scripts/mempalace.mjs init . --yes",
    "mem:mine": "node scripts/mempalace.mjs mine .",
    "mem:status": "node scripts/mempalace.mjs status",
    "mem:wakeup": "node scripts/mempalace.mjs wake-up",
    "mem:search": "node scripts/mempalace.mjs search"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "node scripts/rules-audit.mjs"
    ],
    "*.{css,scss}": "stylelint --fix"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@nuxt/eslint": "1.15.2",
    "@nuxtjs/color-mode": "4.0.0",
    "@nuxtjs/critters": "0.9.0",
    "@nuxtjs/i18n": "10.2.4",
    "@pinia/nuxt": "0.11.3",
    "@tanstack/vue-virtual": "3.13.23",
    "@vueuse/nuxt": "14.2.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "10.2.0",
    "fastify": "^5.10.0",
    "lodash.debounce": "4.0.8",
    "lodash.throttle": "4.1.1",
    "nuxt": "4.4.2",
    "pg": "^8.22.0",
    "pinia": "3.0.4",
    "swiper": "12.1.3",
    "vue": "3.5.32",
    "vue-tsc": "3.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@types/lodash.debounce": "4.0.9",
    "@types/lodash.throttle": "4.1.9",
    "@types/node": "25.5.2",
    "@types/pg": "^8.20.0",
    "@types/swiper": "5.4.3",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "@vitest/browser": "4.1.4",
    "@vitest/coverage-v8": "4.1.4",
    "@vue/test-utils": "2.4.6",
    "cross-env": "7.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-vue": "10.8.0",
    "happy-dom": "17.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "playwright": "1.50.1",
    "sass": "1.85.1",
    "stylelint": "16.18.0",
    "stylelint-config-standard-scss": "14.0.0",
    "stylelint-scss": "6.11.1",
    "tsx": "^4.23.1",
    "typescript": "6.0.2",
    "vite": "6.3.5",
    "vitest": "4.1.4",
    "vue-eslint-parser": "10.4.0"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3"
  }
}
